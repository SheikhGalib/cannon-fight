# --- Build output ----------------------------------------------------------
# Anything that gets regenerated by `mingw32-make` (or by VS / CMake, if
# those are ever brought back). Hand-editing any of these is wasted work -
# the next build overwrites them.

# MinGW / Makefile output (Project1/)
Project1/build_mingw/

# Visual Studio leftovers (the project ships a .vcxproj but we don't open
# VS - the .vs/ scratch dir still shows up)
Project1/.vs/
Project1/x64/
Project1/*.user

# CMake output (opengl-cpp scratch project)
opengl-cpp/build/

# --- Run logs from manual `Start-Process -RedirectStandardOutput` runs ---
# (kept in git history? no, just regeneration debris)
Project1/run_out*.log
Project1/run_err*.log

# --- Documentation-image sidecars ------------------------------------------
# tools/bmp2png.ps1 deletes the .bmp intermediates, but if the conversion
# ever fails mid-run they pile up; ignore either way.
Project1/tools/*.bmp

# Leftover junk from a Windows `del /Q *.exe 2>nul` rule accidentally
# creating a real `nul` file in the project root. Just in case.
nul

# --- 3rd-party libraries vendored into the tree ---------------------------
# These are downloaded by hand from upstream releases - committing them
# keeps the repo huge and means upgrades have to be a separate concern.
Project1/Libraries/include/GLFW/
Project1/Libraries/include/KHR/
Project1/Libraries/include/glad/
Project1/Libraries/include/glm/

opengl-cpp/deps/

# --- OS / editor noise ----------------------------------------------------
# Avoid accidentally committing someone else's machine state.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# --- Python (legacy reference) --------------------------------------------
# legacy/ has its own venv - never commit installed packages
legacy/venv/
__pycache__/
*.pyc

# --- Build artefacts generally -------------------------------------------
*.o
*.obj
*.exe
*.dll
*.a
*.lib